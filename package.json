{
  "name": "taskmate",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "preview": "npm run preview --workspace web",
    "typecheck": "npm run typecheck --workspace web",
    "test": "npm-run-all --serial test:tokens test:sync",
    "test:tokens": "node tools/contrast.mjs",
    "test:sync": "tsx tools/sync.test.ts",
    "test:e2e": "tsx tools/e2e.ts",
    "test:offline": "tsx tools/offline.test.ts",
    "test:rename": "tsx tools/rename.test.ts",
    "shots": "tsx tools/shoot.ts",
    "seed:regen": "node tools/gen-seed.mjs",
    "icons": "tsx tools/icons.ts",
    "illustrations": "node tools/illustrations.mjs"
  },
  "devDependencies": {
    "lucide-static": "^1.31.0",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.62.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
